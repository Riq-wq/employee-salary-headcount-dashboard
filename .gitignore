# ---- Secrets (NEVER commit) ----
.env
*.env
.env.txt
!.env.example

# ---- Jupyter ----
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ---- OS / Editor ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ---- Office / Power BI temp files ----
~$*
*.tmp

# ---- Local backups (never commit these) ----
*.bak
*.orig
*.rej

# ---- Scheduled-run logs ----
# Written by scripts/run_scheduled.py. Local operational output, not source.
logs/

# ---- Safe-editor backups ----
# Written by scripts/edit_source.py before it opens the source file in Excel.
data/.edit_backup/

# ---- Anaconda Navigator artefacts ----
# Created when a project is opened via Anaconda Navigator; not part of the repo.
anaconda_projects/

# ---- Data (uncomment if you don't want raw data in the repo) ----
# data/*.csv
