# Copy this file to `.env` and fill in your own values.
# NEVER commit the real .env — it is gitignored.
#
# The pipeline reads these to build the MySQL connection string:
#   mysql+pymysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME

DB_USER=root
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=employee_db
